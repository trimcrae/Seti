    {
      "shape": "inner_cone",
      "query": "SELECT TOP 5 g.source_id, g.ra, g.dec, g.b, g.parallax, g.parallax_over_error, g.pmra, g.pmdec, g.ruwe, g.phot_g_mean_mag, g.bp_rp, g.phot_variable_flag, g.non_single_star, g.teff_gspphot, g.random_index,\n  w.designation AS allwise_designation, w.w1mpro, w.w1mpro_error, w.w2mpro, w.w2mpro_error, w.w3mpro, w.w3mpro_error, w.cc_flags AS cc_flags, w.ph_qual AS ph_qual, w.ext_flag AS ext_flag, xw.angular_distance AS allwise_sep_arcsec, xw.number_of_neighbours AS allwise_n_neighbours\nFROM (\n  SELECT TOP 1000 gs.source_id, gs.ra, gs.dec, gs.b, gs.parallax, gs.parallax_over_error, gs.pmra, gs.pmdec, gs.ruwe, gs.phot_g_mean_mag, gs.bp_rp, gs.phot_variable_flag, gs.non_single_star, gs.teff_gspphot, gs.random_index\n  FROM gaiadr3.gaia_source AS gs\n  WHERE 1 = CONTAINS(POINT('ICRS', gs.ra, gs.dec), CIRCLE('ICRS', 266.0, 65.0, 1.0))\n    AND gs.phot_g_mean_mag < 14.5\n    AND gs.parallax > 3.0\n    AND gs.parallax_over_error > 10.0\n    AND ABS(gs.b) > 15.0\n    AND gs.ruwe < 1.4\n    AND gs.phot_variable_flag != 'VARIABLE'\n    AND gs.bp_rp > 0.6 AND gs.bp_rp < 2.5\n    AND gs.phot_g_mean_mag + 5 * LOG10(gs.parallax) - 10 > 2.0 + 3.3 * (gs.bp_rp - 0.6)\n) AS g\n  JOIN gaiadr3.allwise_best_neighbour AS xw ON xw.source_id = g.source_id\n  JOIN gaiadr1.allwise_original_valid AS w\n    ON w.designation = xw.original_ext_source_id\nWHERE w.w1mpro - w.w2mpro < 0.15\n  AND w.w1mpro - w.w2mpro > -0.1\n  AND w.ext_flag = 0\n  AND w.cc_flags = '0000'",

\bibitem [{Gau()}]{GaugeFreedom}%
  \BibitemOpen
  \href@noop {} {}\bibinfo {note} {It is worth emphasizing the distinction
  between $S_\mu$ and the electromagnetic vector potential $A_\mu$ regarding
  gauge freedom. In Maxwell theory, the internal $U(1)$ gauge transformation
  (not a coordinate transformation) $A_\mu\mapsto A_\mu+\p_\mu\chi$ leaves the
  physical field strength $F_{\mu\nu}=\p_\mu A_\nu-\p_\nu A_\mu$ invariant
  \cite{Wald1984.book}. By contrast, no analogous gauge freedom has been
  identified for $S_\mu$, and thus no internal gauge-fixing condition is
  imposed in our analysis.}\BibitemShut {Stop}%

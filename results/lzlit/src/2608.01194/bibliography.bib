  title = {Tight and Efficient Gradient Bounds for Parameterized Quantum Circuits},
  journal = {Quantum},
  volume = {8},
  pages = {1484},
  year = {2024},
  doi = {10.22331/q-2024-09-25-1484},
  url = {https://quantum-journal.org/papers/q-2024-09-25-1484/},
  publisher = {Verein zur Förderung des Open Access Publizierens in den Quantenwissenschaften},
  abstract = {Alistair Letcher, Stefan Woerner, and Christa Zoufal, Quantum 8, 1484 (2024). The training of a parameterized model largely depends on the landscape of the underlying loss function. In particular, vanishing gradients are a central bottleneck in the scalability of vari…},

@article{10.1063/1.1654836,
    author = {Hasegawa, Akira and Tappert, Frederick},
    title = {Transmission of stationary nonlinear optical pulses in dispersive dielectric fibers. I. Anomalous dispersion},
    journal = {Applied Physics Letters},
    volume = {23},
    number = {3},
    pages = {142-144},
    year = {1973},
    month = {08},
    abstract = {Theoretical calculations supported by numerical simulations show that utilization of the nonlinear dependence of the index of refraction on intensity makes possible the transmission of picosecond optical pulses without distortion in dielectric fiber waveguides with group velocity dispersion. In the case of anomalous dispersion (∂2ω/∂k2\&gt;0) discussed here [the case of normal dispersion (∂2ω/∂k2\&lt;0) will be discussed in a succeeding letter], the stationary pulse is a ``bright'' pulse, or envelope soliton. For a typical glass fiber guide, the balancing power required to produce a stationary 1‐ps pulse is approximately 1 W. Numerical simulations show that above a certain threshold power level such pulses are stable under the influence of small perturbations, large perturbations, white noise, or absorption.},
    issn = {0003-6951},
    doi = {10.1063/1.1654836},
    url = {https://doi.org/10.1063/1.1654836},
    eprint = {https://pubs.aip.org/aip/apl/article-pdf/23/3/142/18428001/142_1_online.pdf},
}






	doi = {10.1038/s41534-023-00715-7},
	id = {Pang2023},
	isbn = {2056-6387},
	journal = {npj Quantum Information},
	number = {1},
	pages = {62},
	title = {Entangling motional atoms and an optical loop at ambient condition},
	url = {https://doi.org/10.1038/s41534-023-00715-7},
	volume = {9},
	year = {2023},
	bdsk-url-1 = {https://doi.org/10.1038/s41534-023-00715-7}}




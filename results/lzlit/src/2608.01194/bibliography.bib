@phdthesis{chmielewski_quantum_2026,
    type = {Theses},
    title = {Quantum {Machine} {Learning} for {Time} {Series}},
    url = {https://theses.hal.science/tel-05640119},
    doi = {10.70675/11009d43z580bz471cza19dz009654c5df4d},
    abstract = {Time series are datasets generated from dynamical systems and typically exhibit complex dynamical behaviour. Time series arise in many applications such as in medicine, economics, finance, the energy sector and weather forecasting. Because of their dynamical structure, typical machine learning models that are designed for i.i.d. data are not adapted to time series problems. Classically, many model-free, data driven machine learning models attempt to capture certain structures in the dynamics of the time series forclassification tasks, or to reproduce the dynamics for forecasting tasks. The use of the rich dynamics of quantum systems for time series tasks is an emerging topic. This dissertation explores the use of quantum machine learning for time series analysis and forecasting problems, both from a theoretical and anexperimental angle. We investigate two types of machine learning frameworks for time series.First, we analyse the use of quantum computing for topological data analysis (TDA), a computationally costly machine learning framework that can be used to reconstruct the structure of the attractor of the time series. We find that the use of a quantum distance calculation algorithm does not yield a complexity-theoretic advantage over classical algorithms.Second, we thoroughly investigate quantum reservoir computing (QRC) as a low-level, NISQ quantum machine learning framework. Reservoir computing (RC) is a compact neuromorphic recurrent neural network based model that uses the complex dynamics of a physical system to reproduce the dynamics ofthe time series. Universal classes have been identified for both classical RC and QRC. We analyse the generalisation error of modified versions of some of those QRC classes by establishing risk bounds. Our main findings suggest that these QRC classes do generalise in the sense that their generalisation error de-creases with the number of training samples. However, our risk bounds also scale exponentially in the number of qubits, which we attribute to the projective measurements performed on each qubit.Following some of the insights that we gained from the risk bounds, and taking into account the strong physical limitation that still exist in quantum computing, we develop a relatively fast, low-level, NISQ-friendly QRC on a photonic discrete variable quantum computer. We experimentally assess our photonic QRC(pQRC)'s forecasting capacity through simulations on increasingly chaotic time series. Compared to classical RC, our experiments suggest that the pQRC begins to outperform the classical RC on highly chaotic datasets.We provide tools to estimate the runtime of the pQRC on a QPU. Comparing these theo-retical estimates to the measured runtime of classical RC we find that the pQRC scales better with system size in terms of runtime than classical RC.},
    urldate = {2026-07-31},
    school = {Université Paris-Saclay},
    author = {Chmielewski, Naomi Mona},
    month = mar,
    year = {2026},
    note = {Issue: 2026UPAST028},
    keywords = {Analyse de séries temporelles, Analyse topologique des données quantique, Apprentissage quantique, Prévision de séries temporelles, Quantum Machine Learning, Quantum Reservoir Computing, Quantum Topological Data Analysis, Reservoir computing quantique, Time Series Analysis, Time Series Forecasting},
}
@article{creswell_generative_2018,
    title = {Generative {Adversarial} {Networks}: {An} {Overview}},
    volume = {35},
    issn = {1558-0792},
    shorttitle = {Generative {Adversarial} {Networks}},
    url = {https://ieeexplore.ieee.org/document/8253599},
    doi = {10.1109/MSP.2017.2765202},
    abstract = {Generative adversarial networks (GANs) provide a way to learn deep representations without extensively annotated training data. They achieve this by deriving backpropagation signals through a competitive process involving a pair of networks. The representations that can be learned by GANs may be used in a variety of applications, including image synthesis, semantic image editing, style transfer, image superresolution, and classification. The aim of this review article is to provide an overview of GANs for the signal processing community, drawing on familiar analogies and concepts where possible. In addition to identifying different methods for training and constructing GANs, we also point to remaining challenges in their theory and application.},
    number = {1},
    urldate = {2026-07-31},
    journal = {IEEE Signal Processing Magazine},
    author = {Creswell, Antonia and White, Tom and Dumoulin, Vincent and Arulkumaran, Kai and Sengupta, Biswa and Bharath, Anil A.},
    month = jan,
    year = {2018},
    keywords = {Convolutional codes, Data models, Generators, Image resolution, Machine learning, Semantics, Signal resolution, Training data},
    pages = {53--65},
}
@misc{kerenidis_scalable_2026,
    title = {Scalable {Quantum} {Machine} {Learning}: {Trainability}, {Expressivity} and {Efficiency}},
    shorttitle = {Scalable {Quantum} {Machine} {Learning}},
    url = {http://arxiv.org/abs/2607.24014},
    doi = {10.48550/arXiv.2607.24014},
    abstract = {Designing scalable parameterized quantum circuits for machine learning faces three fundamental obstacles: barren plateaus that prevent gradient-based training, the absence of provable guarantees that the learned function class is classically hard, and prohibitive circuit evaluations per gradient step. We propose the unitary brick-wall: a \$k\$-particle fermionic architecture for nearest-neighbor hardware, combining Reconfigurable Beam Splitter gates with interleaved single-qubit phase gates and a non-Gaussian magic-state encoding, where the particle number \$k\$ is a tunable dial trading classical simulation hardness against training cost. Trainable. The brick-wall has dynamical Lie algebra \${\textbackslash}mathfrak\{u\}(n)\$ and directly parametrizes \$U(n)\$ via Givens rotations, enabling Haar initialization. Two-body correlator readouts achieve gradient variance \$Θ(k{\textasciicircum}2/n{\textasciicircum}5)\$. Expressive. Classical hardness is controlled by the particle number \$k\$: best-known classical algorithms for sampling and for two-body expectation values run in time \$2{\textasciicircum}\{Θ(k)\}{\textbackslash}mathrm\{poly\}(n)\$, worst-case \#P-hardness holds at \$k = n{\textasciicircum}ε\$, and average-case hardness applies at \$k = Θ(n)\$. Efficient. A multi-layer parallel parameter-shift rule computes all \$O(n{\textasciicircum}2)\$ gradients from \$k(8n+4)\$ circuit evaluations per gradient step, a factor \$3n/(8k)\$ reduction over the \$3n{\textasciicircum}2\$ evaluations required by the standard parameter-shift rule. The unitary butterfly variant targets all-to-all hardware, with depth \$2{\textbackslash}log n\$ and \$n{\textbackslash}log n\$ parameters. It achieves similar hardness guarantees at \$8k{\textbackslash}log n\$ evaluations per gradient step, the same factor \$3n/(8k)\$ reduction. Its trainability is established at two levels: the absence of exponential barren plateaus is unconditional, whereas the sharp \$Θ(k{\textasciicircum}2/n{\textasciicircum}5)\$ rate holds under a two-particle approximate-2-design conjecture.},
    urldate = {2026-07-31},
    publisher = {arXiv},
    author = {Kerenidis, Iordanis},
    month = jul,
    year = {2026},
    note = {arXiv:2607.24014 [quant-ph]},
    keywords = {Quantum Physics},
}
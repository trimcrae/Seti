@article{reani_data-processing_2013,
	title = {Data-{Processing} {Bounds} for {Scalar} {Lossy} {Source} {Codes} {With} {Side} {Information} at the {Decoder}},
	volume = {59},
	doi = {10.1109/TIT.2013.2249654},
	abstract = {In this paper, we introduce new lower bounds on the distortion of scalar fixed-rate codes for lossy compression with side information available at the receiver. These bounds are derived by presenting the relevant random variables as a Markov chain and applying generalized data-processing inequalities a la Ziv and Zakai. We show that by replacing the logarithmic function with other functions, in the data-processing theorem we formulate, we obtain new lower bounds on the distortion of scalar coding with side information at the decoder. The usefulness of these results is demonstrated for uniform sources and the convex function Q(t)=t1-α, α {\textgreater} 1. The bounds in this case are shown to be better than one can obtain from the Wyner-Ziv rate-distortion function.},
	number = {7},
	journal = {IEEE Transactions on Information Theory},
	author = {Reani, A. and Merhav, N.},
	month = Jul,
	year = {2013},
	note = {00004},
	pages = {4057--4070},
	file = {IEEE Xplore Abstract Record:/Users/eh540/Zotero/storage/5MBCHHHX/6471824.html:text/html;Reani+Merhav-2013-Data-Processing_Bounds_for.pdf:/Users/eh540/Library/Mobile Documents/JFJWWP64QD~com~goodiware~GoodReader/Documents/Zotero/Reani+Merhav-2013-Data-Processing_Bounds_for.pdf:application/pdf}

  abstract = {Understanding whether quantum machine learning algorithms present a genuine computational advantage over classical approaches is challenging. Ewin Tang explains how dequantizing algorithms can uncover when there is no quantum speedup and perhaps help explore analogies between quantum and classical linear algebra.},
  urldate = {2026-04-24},

  abstract = {David Wierichs, Josh Izaac, Cody Wang, and Cedric Yen-Yu Lin, Quantum 6, 677 (2022). Variational quantum algorithms are ubiquitous in applications of noisy intermediate-scale quantum computers. Due to the structure of conventional parametrized quantum gates, the evaluated fu…},

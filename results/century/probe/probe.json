  "daschlab_api_lines_lightcurves": [
    "from .apiclient import ApiClient",
    "client: ApiClient,",
    "refcat: str,",
    "payload = {",
    "\"refcat\": refcat,",
    "data = client.invoke(\"/dasch/dr7/lightcurve\", payload)",
    "raise InteractiveError(f\"lightcurve API request failed: {data!r}\")"
  ],
  "daschlab_api_lines_refcat.py": [
    "radius: u.Quantity,",
    "radius = Angle(radius)",
    "payload = {",
    "\"refcat\": name,",
    "\"radius_arcsec\": radius.arcsec,",
    "data = client.invoke(\"/dasch/dr7/querycat\", payload)",
    "table[\"refcat\"] = [name] * len(input_cols[\"ref_text\"])"
  ],

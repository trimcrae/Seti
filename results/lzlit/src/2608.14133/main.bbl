  \entry{loveridge_quantum_2012}{thesis}{}{}
    \name{author}{1}{}{%
      {{hash=LL}{%
         family={Loveridge},
         familyi={L\bibinitperiod},
         given={Leon},
         giveni={L\bibinitperiod},
      }}%
    }
    \list{language}{1}{%

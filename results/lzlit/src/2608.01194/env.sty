% Flag: are we in appendix?
\newif\ifinappendix
\inappendixfalse

% Activate appendix flag
\pretocmd{\appendix}{\inappendixtrue}{}{}

% Save original sectioning commands
\let\orig@section\section
\let\orig@subsection\subsection
\let\orig@subsubsection\subsubsection

% Redefine section (handles starred + unstarred)
\renewcommand{\section}{%
  \@ifstar
    {\orig@section*}%
    {\app@section}%
}

\newcommand{\app@section}[1]{%
  \orig@section{#1}%
  \ifinappendix
    \addcontentsline{atoc}{section}{%
      \protect\numberline{\thesection}#1%
    }%
  \fi
}

% Redefine subsection
\renewcommand{\subsection}{%
  \@ifstar
    {\orig@subsection*}%
    {\app@subsection}%
}

\newcommand{\app@subsection}[1]{%
  \orig@subsection{#1}%
  \ifinappendix
    \addcontentsline{atoc}{subsection}{%
      \protect\numberline{\thesubsection}#1%
    }%
  \fi
}

% Redefine subsubsection
\renewcommand{\subsubsection}{%
  \@ifstar
    {\orig@subsubsection*}%
    {\app@subsubsection}%
}

\newcommand{\app@subsubsection}[1]{%
  \orig@subsubsection{#1}%
  \ifinappendix
    \addcontentsline{atoc}{subsubsection}{%
      \protect\numberline{\thesubsubsection}#1%
    }%
  \fi
}

\makeatother


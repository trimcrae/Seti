@article{tan_analysis_2016,
	title = {Analysis of {Remaining} {Uncertainties} and {Exponents} under {Various} {Conditional} {R}{\textbackslash}'\{e\}nyi {Entropies}},
	url = {http://arxiv.org/abs/1605.09551},
	abstract = {In this paper, we analyze the asymptotics of the normalized remaining uncertainty of a source when a compressed or hashed version of it and correlated side-information is observed. For this system, commonly known as Slepian-Wolf source coding, we establish the optimal (minimum) rate of compression of the source to ensure that the remaining uncertainties vanish. We also study the exponential rate of decay of the remaining uncertainty to zero when the rate is above the optimal rate of compression. In our study, we consider various classes of random universal hash functions. Instead of measuring remaining uncertainties using traditional Shannon information measures, we do so using two forms of the conditional R{\textbackslash}'\{e\}nyi entropy. Among other techniques, we employ new one-shot bounds and the moments of type class enumerator method for these evaluations. We show that these asymptotic results are generalizations of the strong converse exponent and the error exponent of the Slepian-Wolf problem under maximum {\textbackslash}emph\{a posteriori\} (MAP) decoding.},
	urldate = {2017-12-21},
	journal = {arXiv:1605.09551 [cs, math]},
	author = {Tan, Vincent Y. F. and Hayashi, Masahito},
	month = May,
	year = {2016},
	note = {00006 
	arXiv: 1605.09551},
	keywords = {Computer Science - Cryptography and Security, Computer Science - Information Theory},
	annote = {Comment: 26 pages; 7 figures; To be presented in part at the 2016 International Symposium on Information Theory (ISIT) in Barcelona, Spain},
	file = {arXiv.org Snapshot:/Users/eh540/Zotero/storage/L5RSI6ZG/1605.html:text/html;Tan+Hayashi-2016-Analysis_of_Remaining.pdf:/Users/eh540/Library/Mobile Documents/JFJWWP64QD~com~goodiware~GoodReader/Documents/Zotero/Tan+Hayashi-2016-Analysis_of_Remaining.pdf:application/pdf}
}


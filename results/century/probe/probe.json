  "daschlab_api_lines_exposures.py": [
    "with requests.get(asdf_url, stream=True) as resp:",
    "data = sess._apiclient.invoke(",
    "payload = {",
    "data = client.invoke(\"/dasch/dr7/queryexps\", payload)",
    "ref_radius = np.sqrt((x1 - x0) ** 2 + (y1 - y0) ** 2)",
    "ref_radius /= DSF  # account for the downsampling",
    "ref_radius * f,  # radius"
  ],
  "daschlab_api_lines_apiclient.py": [
    "_URL_ROOT = \"https://api.starglass.cfa.harvard.edu\"",
    "api_key = os.environ.get(\"DASCHLAB_API_KEY\")",
    "self.base_url = os.environ.get(\"DASCHLAB_API_BASE_URL\")",
    "program = os.environ.get(\"DASCHLAB_API_PROGRAM\")",
    "self, endpoint: str, payload: Optional[dict], method: str = \"post\"",
    "print(f\"daschlab API: {method} {endpoint} : {payload!r}\", file=sys.stderr)",
    "return self._invoke_program(endpoint, payload)",
    "return self._invoke_web(endpoint, payload, method)",
    "self, endpoint: str, payload: Optional[dict], method: str",
    "with requests.request(",
    "method, url, json=payload, headers=headers, allow_redirects=False",
    "terse_payload = json.dumps(",
    "payload, ensure_ascii=False, indent=None, separators=(\",\", \":\")",
    "f\"error invoking web API {method} {url} with payload {terse_payload}\"",
    "def _invoke_program(self, endpoint: str, payload: dict) -> object:",
    "pltext = json.dumps(payload)"
  ],
  "daschlab_api_lines___init__.py": [
    "# In order to get ~all catalog sources on a cutout, the radius should be the",
    "REFCAT_RADIUS: Angle = Angle(850 * u.arcsec)",
    "_apiclient: ApiClient",
    "self._apiclient = ApiClient()",
    "self._apiclient, name, self._query.pos_as_skycoord(), REFCAT_RADIUS",
    "return self.refcat()[\"refcat\"][0]",
    "self._apiclient, self._query.pos_as_skycoord()",
    "self._apiclient, src[\"refcat\"], src[\"gsc_bin_index\"], src[\"ref_number\"]",
    "self._apiclient, exp[\"series\"], exp[\"platenum\"], exp[\"solnum\"], center",
    "self._apiclient,",
    "self._query.pos_as_skycoord(), fov=REFCAT_RADIUS * 1.2"
  ],

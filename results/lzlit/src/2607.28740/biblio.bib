#### Footnotes ####
@misc{fn1,
note = {Since there is no constraint that the loops be homologically trivial, Eq.~\eqref{eqn:partition_function} sums over all periodic and anti-periodic boundary conditions for the 2D Ising model.}
}

@misc{fn2,
note = {Although Refs. \onlinecite{BravyiHastingsMichalakis2010} and \onlinecite{BravyiHastings2011} assume an $L\times L$ torus in their proofs, the proof generalizes to arbitrary aspect ratio with no changes.}
}

@misc{fn3,
note = {We note that the expectation values of Wilson loops oriented in the $x\tau$ or $y\tau$ planes in Euclidean spacetime, defined via imaginary time evolution by $H(\beta)$, display \emph{area-law} scaling. Creating two $e$ anyons from the ground state costs energy proportional to their separation, although this is not reflected in the $xy$-oriented Wilson loops.}
}

@misc{fn4,
note = {The two locality bounds \eqref{eq:VrA} and \eqref{eq:locality_bound} are equivalent; see the Supplemental Material \cite{SOM} for a simple proof.}
}

@misc{fn5,
note = {Such a bound further implies that there exists a local generator that produces $\ket{\psi(\beta)}$ from $\ket{0}$ under finite time evolution, for sufficiently large $\beta$~\cite{Yin_Lucas_low-density_2025,DeRoeck_Khemani_low-density_2025}.}
}

